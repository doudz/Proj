# Copiez ce fichier en .env et adaptez les valeurs avant le premier demarrage.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Europe/Paris

# --- Base de donnees PostgreSQL ---
POSTGRES_DB=ganttflow
POSTGRES_USER=ganttflow
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (Channels / WebSocket) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- CORS / CSRF (domaine(s) depuis lesquels le frontend est servi) ---
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173

# --- Compte super-utilisateur cree automatiquement au demarrage (optionnel) ---
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# --- E-mail (notification "tache disponible" lorsqu'une dependance bloquante
#     est terminee). Par defaut, en DEBUG=true, les e-mails sont juste
#     affiches dans les logs du conteneur backend (aucune config requise).
#     En production, renseignez un serveur SMTP (ex: SendGrid, Mailgun,
#     OVH...) et EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=GanttFlow <noreply@mondomaine.fr>

# --- URL publique du frontend, utilisee dans les liens des e-mails ---
FRONTEND_URL=https://gantt.mondomaine.fr

# --- Port HTTP expose par le conteneur frontend (nginx) ---
HTTP_PORT=80
