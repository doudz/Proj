# Fichier .env genere a partir de .env.example, pret pour un premier demarrage
# (ex: chargement direct du stack docker-compose.yml depuis Dockhand/Dockge/Portainer).
#
# IMPORTANT - a faire avant d'exposer l'outil publiquement :
#   1. Remplacez CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS / FRONTEND_URL par
#      votre vrai domaine (http://localhost convient uniquement en local).
#   2. Renseignez un serveur SMTP reel (EMAIL_HOST / EMAIL_HOST_USER /
#      EMAIL_HOST_PASSWORD) si vous voulez que les notifications par e-mail
#      partent reellement - sans cela elles echouent silencieusement.
#   3. DJANGO_SECRET_KEY et POSTGRES_PASSWORD ci-dessous ont ete generes
#      aleatoirement pour vous : ne les partagez pas, et regenerez-les si ce
#      depot venait a devenir public.

# --- Django ---
DJANGO_SECRET_KEY=obv7Dsx64tt4Y3dLypDI6io8AEMTAfxEf4XPPCPNtntiZHjZy1
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Europe/Paris

# --- Base de donnees PostgreSQL ---
POSTGRES_DB=ganttflow
POSTGRES_USER=ganttflow
POSTGRES_PASSWORD=nQU3WZWyjfkXSrUnghWbPu2R
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (Channels / WebSocket) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- CORS / CSRF (domaine(s) depuis lesquels le frontend est servi) ---
# A adapter des que l'outil n'est plus accede uniquement en http://localhost.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173

# --- Compte super-utilisateur cree automatiquement au demarrage ---
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=bZYMiLu7opCb4dC7

# --- E-mail (notification "tache disponible" lorsqu'une dependance bloquante
#     est terminee, et assignation d'un contact externe). Laisse au backend
#     console par defaut : les e-mails s'affichent dans les logs du conteneur
#     backend (`docker compose logs -f backend`) tant qu'aucun SMTP n'est
#     renseigne ci-dessous.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=GanttFlow <noreply@mondomaine.fr>

# --- URL publique du frontend, utilisee dans les liens des e-mails ---
FRONTEND_URL=http://localhost

# --- Port HTTP expose par le conteneur frontend (nginx) ---
# Changez-le si le port 80 est deja utilise sur la machine qui heberge Dockhand.
HTTP_PORT=80
